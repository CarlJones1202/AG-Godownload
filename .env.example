# Copy to .env for local development. Never commit real keys, tokens, cookies,
# database passwords, or WireGuard private keys.

# Server
PORT=8080
LOG_LEVEL=INFO

# PostgreSQL (init.ps1 normally writes these)
PGHOST=
PGPORT=
PGUSER=
PGDATABASE=
PGPASSWORD=
# DATABASE_URL=

# Maintenance endpoints
MAINTENANCE_TOKEN=

# ThePornDB provider alias lookup
TPDB_API_KEY=

# Optional WireGuard tunnel for selected scraper domains
WIREGUARD_CONF=

# Optional gallery-dl fallback for IMX and other protected hosts
GALLERYDL_ENABLED=true
GALLERYDL_BINARY=gallery-dl
GALLERYDL_TIMEOUT_SEC=30

# Parallel missing-gallery scans; scans for each provider remain serialized
PERSON_SCAN_WORKERS=4

# Optional local semantic embeddings (empty EMBED_MODEL_PATH uses the built-in
# low-level descriptor provider)
EMBED_MODEL_PATH=
EMBED_MODEL_NAME=
EMBED_DIM=
EMBED_PYTHON=
